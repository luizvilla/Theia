{
  "private": true,
  "name": "ownstudio-electron",
  "version": "0.1.0",
  "license": "LGPL-2.1-only",
  "main": "lib/backend/electron-main.js",
  "theia": {
    "target": "electron",
    "frontend": {
      "config": {
        "applicationName": "OwnStudio",
        "defaultTheme": {
          "light": "ownstudio-light",
          "dark": "ownstudio-dark"
        },
        "defaultIconTheme": "theia-file-icons",
        "preferences": {
          "toolbar.showToolbar": false,
          "security.workspace.trust.enabled": false,
          "window.titleBarStyle": "custom"
        }
      }
    }
  },
  "dependencies": {
    "@ownstudio/core": "0.1.0",
    "@theia/ai-anthropic": "1.76.0",
    "@theia/ai-chat": "1.76.0",
    "@theia/ai-chat-ui": "1.76.0",
    "@theia/ai-core": "1.76.0",
    "@theia/ai-ollama": "1.76.0",
    "@theia/ai-openai": "1.76.0",
    "@theia/core": "1.76.0",
    "@theia/editor": "1.76.0",
    "@theia/electron": "1.76.0",
    "@theia/file-search": "1.76.0",
    "@theia/filesystem": "1.76.0",
    "@theia/markers": "1.76.0",
    "@theia/messages": "1.76.0",
    "@theia/monaco": "1.76.0",
    "@theia/navigator": "1.76.0",
    "@theia/output": "1.76.0",
    "@theia/plugin-ext": "1.76.0",
    "@theia/plugin-ext-vscode": "1.76.0",
    "@theia/preferences": "1.76.0",
    "@theia/process": "1.76.0",
    "@theia/terminal": "1.76.0",
    "@theia/workspace": "1.76.0"
  },
  "devDependencies": {
    "@theia/cli": "1.76.0",
    "electron": "42.8.1"
  },
  "scripts": {
    "build": "theia build --mode development",
    "start": "env -u ELECTRON_RUN_AS_NODE theia start --plugins=local-dir:plugins",
    "download:plugins": "theia download:plugins"
  },
  "theiaPluginsDir": "plugins",
  "theiaPlugins": {
    "vscode.cpp": "https://open-vsx.org/api/vscode/cpp/1.95.3/file/vscode.cpp-1.95.3.vsix",
    "vscode.python": "https://open-vsx.org/api/vscode/python/1.95.3/file/vscode.python-1.95.3.vsix",
    "vscode.json": "https://open-vsx.org/api/vscode/json/1.95.3/file/vscode.json-1.95.3.vsix",
    "vscode.yaml": "https://open-vsx.org/api/vscode/yaml/1.95.3/file/vscode.yaml-1.95.3.vsix",
    "vscode.git": "https://open-vsx.org/api/vscode/git/1.95.3/file/vscode.git-1.95.3.vsix",
    "vscode.git-base": "https://open-vsx.org/api/vscode/git-base/1.95.3/file/vscode.git-base-1.95.3.vsix",
    "llvm-vs-code-extensions.vscode-clangd": "https://open-vsx.org/api/llvm-vs-code-extensions/vscode-clangd/0.6.0/file/llvm-vs-code-extensions.vscode-clangd-0.6.0.vsix",
    "detachhead.basedpyright": "https://open-vsx.org/api/detachhead/basedpyright/1.40.2/file/detachhead.basedpyright-1.40.2.vsix"
  }
}
