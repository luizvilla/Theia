    "@theia/ai-core": "1.77.0",
    "@theia/core": "1.77.0",
    "@theia/filesystem": "1.77.0",
    "@theia/monaco": "1.77.0",
    "@theia/output": "1.77.0",
    "@theia/terminal": "1.77.0",
    "@theia/workspace": "1.77.0",
    "@xyflow/react": "12.12.0",
    "js-yaml": "^4.1.0",
    "uplot": "1.6.32"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.0.0",
    "@types/react": "^19.3.0",
    "rimraf": "^5.0.0",
    "typescript": "~5.6.3"
